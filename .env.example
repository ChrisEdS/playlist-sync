# --- App ---
# Local unlock PIN (ignored when DISABLE_APP_PIN=1)
APP_PIN=change-me
# Set to 1 when Vercel Deployment Protection is enough (skips app PIN)
DISABLE_APP_PIN=
# Public URL of this deploy (OAuth redirects depend on it)
APP_URL=http://localhost:3000

# Secrets — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
SESSION_SECRET=generate-another-long-random-string
CRON_SECRET=generate-a-long-random-string

# --- Database ---
# Neon (Vercel Marketplace → DATABASE_URL)
# Leave empty locally to use embedded PGlite in ./data/pglite
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Optional provider env fallbacks ---
# Preferred: paste Client ID/Secret in the in-app Settings UI (encrypted in DB)
# Spotify Developer Dashboard → https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Redirect URI to register: {APP_URL}/api/auth/spotify/callback

# Tidal Developer Platform → https://developer.tidal.com
TIDAL_CLIENT_ID=
# Redirect URI: {APP_URL}/api/auth/tidal/callback (authorization code + PKCE)
# Client secret optional depending on Tidal app type
TIDAL_CLIENT_SECRET=
# Catalog country (ISO 3166-1 alpha-2), default DE
TIDAL_COUNTRY=DE

# --- Optional ---
# Override the in-app “Unterstützen” link (default: GitHub Sponsors)
# NEXT_PUBLIC_DONATION_URL=https://ko-fi.com/yourname
